{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1100px" },
    "color": {
      "palette": [
        { "slug": "red", "name": "Red", "color": "#c62828" },
        { "slug": "maroon", "name": "Maroon", "color": "#8b0000" },
        { "slug": "yellow", "name": "Yellow", "color": "#f1c40f" },
        { "slug": "orange", "name": "Orange", "color": "#e64a19" },
        { "slug": "ink", "name": "Ink", "color": "#1d2327" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    }
  },
  "styles": {
    "color": { "background": "#ffffff", "text": "#1d2327" },
    "typography": { "fontFamily": "Nunito, sans-serif", "fontSize": "16px", "lineHeight": "1.75" },
    "elements": {
      "heading": { "typography": { "fontFamily": "Montserrat, sans-serif", "fontWeight": "700" } },
      "link": { "color": { "text": "#c62828" } },
      "button": { "color": { "background": "#c62828", "text": "#ffffff" }, "border": { "radius": "8px" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-hi", "title": "Hindi Homepage", "postTypes": ["page"] },
    { "name": "page-about", "title": "About (English)", "postTypes": ["page"] },
    { "name": "page-about-hindi", "title": "About (Hindi)", "postTypes": ["page"] },
    { "name": "page-disclaimer", "title": "Disclaimer (English)", "postTypes": ["page"] },
    { "name": "page-disclaimer-hindi", "title": "Disclaimer (Hindi)", "postTypes": ["page"] },
    { "name": "page-download", "title": "Download", "postTypes": ["page"] },
    { "name": "page-register", "title": "Register", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
