{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1100px" },
    "color": {
      "palette": [
        { "slug": "purple", "name": "Purple", "color": "#4a148c" },
        { "slug": "purple-deep", "name": "Purple Deep", "color": "#330968" },
        { "slug": "gold", "name": "Gold", "color": "#ffb300" },
        { "slug": "orange", "name": "Orange CTA", "color": "#ff6900" },
        { "slug": "navy", "name": "Navy", "color": "#020381" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    }
  },
  "styles": {
    "color": { "background": "#ffffff", "text": "#1f2937" },
    "typography": { "fontFamily": "Nunito, sans-serif", "fontSize": "16px", "lineHeight": "1.7" },
    "elements": {
      "heading": { "typography": { "fontFamily": "Montserrat, sans-serif", "fontWeight": "700" } },
      "link": { "color": { "text": "#4a148c" } },
      "button": { "color": { "background": "#ff6900", "text": "#ffffff" }, "border": { "radius": "8px" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-hi", "title": "Hindi Homepage", "postTypes": ["page"] },
    { "name": "page-about", "title": "About (English)", "postTypes": ["page"] },
    { "name": "page-about-hindi", "title": "About (Hindi)", "postTypes": ["page"] },
    { "name": "page-disclaimer", "title": "Disclaimer (English)", "postTypes": ["page"] },
    { "name": "page-disclaimer-hindi", "title": "Disclaimer (Hindi)", "postTypes": ["page"] }
  ]
}
