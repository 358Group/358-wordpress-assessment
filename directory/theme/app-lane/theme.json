{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1100px" },
    "color": {
      "palette": [
        { "slug": "header", "name": "Dark Header", "color": "#1d222d" },
        { "slug": "orange", "name": "Orange", "color": "#ff9800" },
        { "slug": "green", "name": "Green", "color": "#2ecc71" },
        { "slug": "gold", "name": "Gold", "color": "#ffd700" },
        { "slug": "blue", "name": "Blue", "color": "#1eb7ea" }
      ]
    }
  },
  "styles": {
    "color": { "background": "#f4f5f7", "text": "#363636" },
    "typography": { "fontFamily": "Poppins, sans-serif", "fontSize": "15px" },
    "elements": {
      "link": { "color": { "text": "#0461dd" } },
      "button": { "color": { "background": "#ff9800", "text": "#ffffff" }, "border": { "radius": "4px" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-app-detail", "title": "App Detail", "postTypes": ["page"] },
    { "name": "page-legal", "title": "Disclaimer", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact", "postTypes": ["page"] }
  ]
}
